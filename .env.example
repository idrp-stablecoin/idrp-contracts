# idrp-contracts — environment variables for scripts/ and hardhat.config.ts
#
# Copy to .env and fill in real values. Every value below is a placeholder —
# nothing here is a real credential.
#
# Note: the private keys and RPC/API keys hardhat.config.ts itself needs
# (account keys, Alchemy/Infura/Etherscan/Kaia keys) live in Hardhat's own
# encrypted vars keystore, NOT in this file — set those with:
#   npx hardhat vars set IDRP_DEPLOYER_PRIVATE_KEY
#   npx hardhat vars set ALCHEMY_API_KEY
# The variables below are read directly via process.env by individual scripts.

# ── Safety (Rule 0) ─────────────────────────────────────────────────────────
# Required ack to run a mainnet-guarded script against chain id 1 / 56 / 137 /
# 8217 (Ethereum / BSC / Polygon / Kaia). Leave unset for testnets.
ALLOW_MAINNET=

# ── RPC / keys ───────────────────────────────────────────────────────────────
# A few scripts read these directly via process.env (most of hardhat.config.ts's
# own copies live in the vars keystore instead — see note above).
ALCHEMY_API_KEY=
ETHERSCAN_API_KEY=
COINMARKETCAP_API_KEY=
# Raw private key (must start with 0x). Used by scripts/deploy-proxy.ts.
IDRP_DEPLOYER_PRIVATE_KEY=0x...
# Alternative signer for scripts/controller-unpause.ts's manager+director+commissioner path.
COMMISSIONER_PRIVATE_KEY=0x...

# ── Deployment address overrides ────────────────────────────────────────────
# Skip the deployment/chain-<id>.json lookup and use this address instead.
IDRP_ADDRESS=0x...
# scripts/sanctions/manage-list.ts, seed-from-opensanctions.ts: skip discovery via token.sanctionsList().
SANCTIONS_LIST_ADDRESS=0x...
# scripts/sanctions/fetch-chain-events.ts: defaults to the Chainalysis oracle address.
SANCTIONS_CONTRACT_ADDRESS=0x...

# ── v3 migration overrides ──────────────────────────────────────────────────
# scripts/upgrade-v3-idrp.ts initializeV3(...) args. Default to the current
# upgrader / deployment.IDRPController on-chain values when unset.
IDRP_V3_ADMIN=0x...
IDRP_V3_CONTROLLER=0x...
IDRP_V3_UPGRADER=0x...
# scripts/upgrade-v3-controller.ts equivalents.
CTRL_V3_ADMIN=0x...
CTRL_V3_UPGRADER=0x...

# ── Sanctions tooling (scripts/sanctions/) ──────────────────────────────────
# manage-list.ts action: status (default, read-only) | add | remove.
ACTION=status
# manage-list.ts / seed-from-opensanctions.ts: set to 1 to actually send the
# transaction (both default to a dry-run / status-only preview otherwise).
APPLY=
# manage-list.ts: comma-separated wallet address(es), 0x... (EVM) or T... (Tron).
WALLET=0x...
# fetch-opensanctions.ts: OpenSanctions API key (optional in dev — falls back
# to a small unauthenticated volume without it).
OPENSANCTIONS_API_KEY=
# fetch-opensanctions.ts: set to 1 to use a small local fixture set instead of
# calling the OpenSanctions API (no API key needed).
OPENSANCTIONS_FIXTURE=
# seed-from-opensanctions.ts: explicit snapshot file to apply. Defaults to the
# most recent file in scripts/sanctions/results/.
SANCTIONS_SNAPSHOT_PATH=scripts/sanctions/results/<timestamp>.json
# fetch-chain-events.ts / fetch-opensanctions.ts: override the output directory
# for written snapshot JSON files. Defaults to scripts/sanctions/results/.
FETCH_OUTPUT_DIR=
# fetch-chain-events.ts: block range for the Etherscan-logs / eth_getLogs replay.
FROM_BLOCK=
TO_BLOCK=
# fetch-chain-events.ts: force the direct-RPC eth_getLogs path even when
# ETHERSCAN_API_KEY is set and the chain is Etherscan-supported.
USE_RPC=
